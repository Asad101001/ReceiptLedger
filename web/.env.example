# ==============================================================================
# ReceiptLedger Web Dashboard - Environment Configuration
# ==============================================================================
# Base URL for the FastAPI Backend Gateway
#
# Local Development:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Free Cloudflare / Pinggy Tunnel (from running `run_tunneled_backend.bat`):
# VITE_API_BASE_URL=https://<your-tunnel-subdomain>.trycloudflare.com/api/v1
#
# Production Backend (Render / Railway / Hugging Face / VPS):
# VITE_API_BASE_URL=https://<your-backend-api-domain>/api/v1
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
